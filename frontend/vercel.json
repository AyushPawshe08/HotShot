{
  "rewrites": [
    {
      "source": "/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/:shortcode([a-zA-Z0-9]{4,12})",
      "destination": "https://hotshot-488i.onrender.com/:shortcode"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
